{
    "name": "ndfirewall/laravel-waf",
    "description": "Lightweight, route-scoped WAF for Laravel. Detects RCE, SQLi, XSS, LFI/RFI, SSRF and deserialization payloads without ever executing them. Fails open by design.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "NDFirewall\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NDFirewall\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "NDFirewall\\NDFirewallServiceProvider"
            ],
            "aliases": {
                "NDFirewall": "NDFirewall\\Facades\\NDFirewall"
            }
        }
    },
    "minimum-stability": "stable"
}
